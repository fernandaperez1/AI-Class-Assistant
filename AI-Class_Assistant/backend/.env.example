HOST=0.0.0.0
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@db:5432/class_assistant
CORS_ORIGINS=http://localhost:5173

# AI Provider Configuration
# Options: "gemini" or "openai"
AI_PROVIDER=gemini

# API Keys (only the one matching AI_PROVIDER is required)
OPENAI_API_KEY=your_openai_key
GOOGLE_API_KEY=00000000000000000000

# AI Retry Configuration
AI_MAX_RETRIES=3          # Maximum number of retry attempts if AI request fails
AI_RETRY_DELAY=2.0        # Initial delay in seconds between retries (uses exponential backoff)

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=class_assistant
DB_USER=postgres
DB_PASSWORD=postgres
